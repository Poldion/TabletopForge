[Unit]
Description=Seat-Verwaltung für den Kiosk-Browser (Bildschirm und Eingabegeräte für cage)
DefaultDependencies=no
After=systemd-udevd.service

[Service]
Type=simple
# Zugriff für die Gruppe video (Kiosk-Benutzer)
ExecStart=/usr/bin/seatd -g video
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
